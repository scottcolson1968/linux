// SPDX-License-Identifier: GPL-2.0
/*
 * Analog Devices AD4080 (EVAL-AD4080-FMC) on Digilent Genesys ZU-5EV
 * (Zynq UltraScale+ XCZU5EV). Wildcat2 board.
 * https://www.analog.com/en/products/ad4080.html
 * https://www.analog.com/eval-ad4080-fmc
 *
 * hdl_project: <ad4080_fmc_evb/genesys_zu5ev>  (local port, not in upstream ADI hdl)
 *
 * Derived from zynqmp-genesys-zu-5ev-ad7383-4.dts: the carrier + backhaul
 * (10G SFP+, USB, si5342, RGB LED, 30 MHz PS_REF_CLK, CCI) are reused; the ADC
 * datapath is the AD4080 LVDS capture (axi_ad408x IIO backend + axi_dmac),
 * controlled over PS SPI0, with the conversion clock from the eval AD9508/ADF4350.
 *
 * PL peripherals use the 0x80xxxxxx aperture (this carrier reaches the PL via
 * M_AXI_HPM0_LPD, whose window is 0x8000_0000..0x9FFF_FFFF). Must match the
 * ad4080_fmc_evb_genesys_zu5ev HDL system_bd.tcl.
 *
 * Copyright (C) 2026 Analog Devices Inc.
 */
/dts-v1/;

#include "zynqmp.dtsi"
#include "zynqmp-clk-ccf.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/net/ti-dp83867.h>
#include <dt-bindings/phy/phy.h>

/ {
	model = "Digilent Genesys ZU-5EV + EVAL-AD4080 FMC (Wildcat2)";
	compatible = "digilent,genesys-zu-5ev", "xlnx,zynqmp";

	aliases {
		ethernet0 = &gem0;
		serial0 = &uart0;
		serial1 = &uart1;
		mmc0 = &sdhci0; /* eMMC */
		mmc1 = &sdhci1; /* microSD */
		spi0 = &qspi;
	};

	chosen {
		bootargs = "earlycon console=ttyPS0,115200 root=/dev/mmcblk1p2 rw rootwait cma=512M";
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>, <0x8 0x0 0x0 0x80000000>;
	};

	refclk2: psgtr_dp_clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <108000000>;
	};
	refclk1: psgtr_sata_clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <150000000>;
	};
	refclk0: psgtr_pcie_usb30_clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <100000000>;
	};
	refclk3: psgtr_usb30_clock {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <100000000>;
	};
	ref48: ref48M {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <48000000>;
	};

	/* AD4080 supplies (from FMC rails). vdd33 + vrefin are the mandatory
	 * regulators in the ad4080 binding. */
	vdd33: ad4080-vdd33-regulator {
		compatible = "regulator-fixed";
		regulator-name = "AD4080 VDD33 (FMC +3.3V)";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	vrefin: ad4080-vrefin-regulator {
		compatible = "regulator-fixed";
		regulator-name = "AD4080 VREFIN";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/* Y1 on the EVAL-AD4080-FMC: 25 MHz TCXO (ECS-TXO-2016-33-250, 2 ppm),
	 * gated by OSC_EN, which system_top.v ties to PWRGD so it comes up with the
	 * board. This is the ADF4350 reference. */
	clk25m: clk25m-tcxo {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <25000000>;
		clock-output-names = "clk25m";
	};
};

&uart0 { status = "okay"; };
&uart1 { status = "okay"; };

&psgtr {
	status = "okay";
	clocks = <&refclk0>, <&refclk1>, <&refclk2>, <&refclk3>;
	clock-names = "ref0", "ref1", "ref2", "ref3";
};

&sdhci1 {
	status = "okay";
	disable-wp;
	no-1-8-v;
	xlnx,itap-delay-sd-hsd = <0x29>;
	xlnx,itap-delay-sd-ddr50 = <0x32>;
	xlnx,itap-delay-sdr25 = <0x2A>;
	xlnx,itap-delay-sdr50 = <0x1E>;
	xlnx,itap-delay-sdr104 = <0x0B>;
};

&sdhci0 {
	status = "okay";
	non-removable;
	bus-width = <8>;
};

&gem0 {
	status = "okay";
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	#address-cells = <1>;
	#size-cells = <0>;
	phy0: ethernet-phy@f {
		reg = <0xF>;
		reset-assert-us = <1>;
		reset-deassert-us = <200>;
		interrupt-parent = <&gpio>;
		interrupts = <38 IRQ_TYPE_LEVEL_LOW>;
		ti,rx-internal-delay = <DP83867_RGMIIDCTL_2_00_NS>;
		ti,tx-internal-delay = <DP83867_RGMIIDCTL_1_50_NS>;
		ti,fifo-depth = <DP83867_PHYCR_FIFO_DEPTH_4_B_NIB>;
		ti,clk-output-sel = <DP83867_CLK_O_SEL_REF_CLK>;
	};
};

&i2c0 {
	status = "okay";
	i2c-mux@70 {
		compatible = "nxp,pca9548";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x70>;
		reset-gpios = <&gpio 78 GPIO_ACTIVE_HIGH>;
		i2c-mux-idle-disconnect;

		i2c@0 { #address-cells = <1>; #size-cells = <0>; reg = <0>; };
		i2c@1 { #address-cells = <1>; #size-cells = <0>; reg = <1>; };
		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;
			/* Si5342 -> 156.25 MHz GT refclk for the 10G SFP+ */
			si5342: clock-generator@68 {
				compatible = "silabs,si5342";
				reg = <0x68>;
				#clock-cells = <2>;
				#address-cells = <1>;
				#size-cells = <0>;
				clocks = <&ref48>;
				clock-names = "xtal";
				silabs,iovdd-33;
				si5342_out0: out@0 { reg = <0>; always-on; };
				si5342_out1: out@1 { reg = <1>; always-on; };
			};
		};
		i2c@3 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <3>;
			pmu@13 { compatible = "infineon,irps5401"; reg = <0x13>; };
			pmu@14 { compatible = "infineon,irps5401"; reg = <0x14>; };
			pmu@15 { compatible = "infineon,irps5401"; reg = <0x15>; };
		};
		i2c@4 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <4>;
			eeprom@51 { /* FMC VITA 57.1 FRU */
				compatible = "atmel,24c02";
				reg = <0x51>;
				pagesize = <1>;
			};
		};
		i2c@5 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <5>;
			eeprom@30 { /* SYZYGY DNA */
				compatible = "atmel,24c02";
				reg = <0x30>;
				read-only;
				address-width = <16>;
				size = <65536>;
			};
		};
		i2c@6 { #address-cells = <1>; #size-cells = <0>; reg = <6>; };
		i2c@7 { #address-cells = <1>; #size-cells = <0>; reg = <7>; };
	};
};

&qspi {
	status = "okay";
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <80000000>;
		spi-tx-bus-width = <1>;
		spi-rx-bus-width = <1>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			partition@0 { label = "boot"; reg = <0x00000000 0x00100000>; };
			partition@1 { label = "bootenv"; reg = <0x00100000 0x00040000>; };
			partition@2 { label = "kernel"; reg = <0x00140000 0x01600000>; };
			partition@3 { label = "board-id"; reg = <0x1FFF000 0x1000>; read-only; };
		};
	};
};

&usb0 {
	status = "okay";
	xlnx,tz-nonsecure = <1>;
	xlnx,usb-polarity = <0>;
	xlnx,usb-reset-mode = <0>;
};

&dwc3_0 {
	status = "okay";
	dr_mode = "peripheral";
	snps,usb3_lpm_capable;
	phy-names = "usb3-phy";
	phys = <&psgtr 1 PHY_TYPE_USB3 0 0>;
	snps,dis_u2_susphy_quirk;
	snps,dis_u3_susphy_quirk;
	maximum-speed = "super-speed";
	tx-fifo-resize;
};

/* PL peripherals (ad4080_fmc_evb_genesys_zu5ev HDL project). 0x80xxxxxx = the
 * M_AXI_HPM0_LPD aperture on this carrier. Addresses match system_bd.tcl. */
/ {
	fpga_axi: fpga-axi@0 {
		interrupt-parent = <&gic>;
		compatible = "simple-bus";
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		ranges = <0 0 0 0xffffffff>;

		/* 10G Ethernet over SFP+ : xxv_ethernet MAC + axi_mcdma (reused). */
		eth_mcdma: dma@80020000 {
			compatible = "xlnx,eth-dma";
			reg = <0x80020000 0x10000>;
			xlnx,addrwidth = <0x20>;
			xlnx,include-dre;
		};

		xxv_eth: ethernet@80060000 {
			compatible = "xlnx,xxv-ethernet-1.0";
			reg = <0x80060000 0x10000>;
			device_type = "network";
			axistream-connected = <&eth_mcdma>;
			xlnx,num-queues = /bits/ 16 <1>;
			xlnx,channel-ids = "1";
			interrupt-parent = <&gic>;
			interrupts = <0 106 IRQ_TYPE_LEVEL_HIGH>,
				     <0 107 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "mm2s_ch1_introut", "s2mm_ch1_introut";
			local-mac-address = [00 0a 35 05 a1 10];
			max-speed = <10000>;
			phy-mode = "10gbase-r";
			xlnx,rxmem = <0x6000>;
			xlnx,txcsum = <1>;
			xlnx,rxcsum = <0>;
			fixed-link {
				speed = <10000>;
				full-duplex;
			};
		};

		/* AD4080 RX DMA (axi_dmac). On S_AXI_HP0 (non-coherent), so NO
		 * dma-coherent here (unlike the 10G HPC0 path). */
		rx_dma: dma-controller@80000000 {
			compatible = "adi,axi-dmac-1.00.a";
			reg = <0x80000000 0x1000>;
			#dma-cells = <1>;
			interrupts = <0 109 IRQ_TYPE_LEVEL_HIGH>; /* ps-13 */
			clocks = <&zynqmp_clk 71>;
		};

		/* AD4080 capture IP = IIO backend (adi-axi-adc.c binds adi,axi-ad408x). */
		axi_ad408x: axi-adc@80010000 {
			compatible = "adi,axi-ad408x";
			reg = <0x80010000 0x10000>;
			dmas = <&rx_dma 0>;
			dma-names = "rx";
			clocks = <&zynqmp_clk 71>;
			#io-backend-cells = <0>;
		};

		/* clock monitor (DCO + 100 MHz ref) -- diagnostic. */
		ad4080_clock_monitor: clock-monitor@80050000 {
			compatible = "adi,axi-clock-monitor-1.00.a";
			reg = <0x80050000 0x10000>;
			clocks = <&zynqmp_clk 71>;
			clock-names = "s_axi_aclk";
		};

		rgb_led_gpio: gpio@80080000 {
			compatible = "xlnx,axi-gpio-2.0", "xlnx,xps-gpio-1.00.a";
			reg = <0x80080000 0x1000>;
			#gpio-cells = <2>;
			gpio-controller;
			xlnx,all-inputs = <0x0>;
			xlnx,all-outputs = <0x1>;
			xlnx,gpio-width = <0x3>;
			xlnx,is-dual = <0x0>;
			clocks = <&zynqmp_clk 71>;
		};
	};
};

/* PS_REF_CLK crystal is 30 MHz on this board. */
&pss_ref_clk {
	clock-frequency = <30000000>;
};

/* CCI-400 for the coherent HPC0 10G DMA path. */
&cci {
	status = "okay";
};

/*
 * PS SPI0 (EMIO) -> AD4080 register control on the FMC card. In the AD7383
 * design SPI0 carried the on-board MCP23S08 gpio-expander + WiFi; on Wildcat2
 * the HDL routes EMIO SPI0 to the FMC AD4080 instead, so those are removed here.
 * USB PHY/hub resets are programmed by the Digilent FSBL at boot (they were the
 * gpioexp hogs), so USB still enumerates; on-board WiFi (ATWINC1500) is unusable
 * on Linux anyway -- use a USB adapter.
 */
&spi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	ad4080: adc@0 {
		compatible = "adi,ad4080";
		reg = <0>;
		spi-max-frequency = <10000000>;
		spi-cpol;
		spi-cpha;

		/* AD9508 OUT2 = CNV_P/N, 32.768 MHz (327.68 / 10) */
		clocks = <&ad9508 2>;
		clock-names = "cnv";

		io-backends = <&axi_ad408x>;

		adi,num-lanes = <2>;

		/* The eval board drives CNV differentially, from AD9508 OUT2 on
		 * CNV_P/CNV_N, but the AD4080 powers up with CNV in CMOS mode.
		 * This property is what makes the driver set LVDS_CNV_EN, program
		 * LVDS_CNV_CLK_CNT and -- critically -- run the lane alignment:
		 * all three sit behind the same guard, so without it the part
		 * ignores the differential CNV AND the lanes are never trained,
		 * with nothing in the logs pointing at the cause. */
		adi,lvds-cnv-enable;

		vdd33-supply = <&vdd33>;
		vrefin-supply = <&vrefin>;
	};
};

/*
 * PS SPI1 (EMIO) -> eval AD9508 clock fanout + ADF4350 PLL (the CNV clock
 * generator). Left disabled for initial bring-up (ad4080_cnv_clk is modelled as
 * a fixed-clock above). TODO: add adi,ad9508 + adi,adf4350 nodes and switch the
 * ad4080 "cnv" clock to the real AD9508 output once the clock chain is verified.
 */
/* EVAL-AD4080-FMC precision clock generation/distribution (schematic sheet 8),
 * on PS SPI1 via EMIO. Chip selects follow system_top.v:
 *   ad9508_csn  = spi1_csn[0]
 *   adf4350_csn = spi1_csn[1]
 * SCLK/MOSI/MISO are shared between the two devices.
 *
 * Chain: Y1 25 MHz TCXO -> ADF4350 RFOUTA+/- -> AD9508 CLK (differential input;
 * IN_SEL is tied high on the eval board) -> OUT0 FPGACLK to FMC CLK1_M2C,
 * OUT2 CNV (40 MHz max), OUT3 CLK (400 MHz max). OUT1 is unused.
 *
 * WildCat2 operating point:
 *   ADF4350 = 327.68 MHz EXACTLY. With a 25 MHz PFD and adi,channel-spacing of
 *   40 kHz the driver computes MOD = 25e6/40e3 = 625, giving INT 104, FRAC 536
 *   and an RF divider of 8: 25 MHz x (104 + 536/625) / 8 = 327.68 MHz with no
 *   frequency error, which the power-of-two FFT frame requires.
 *   AD9508 OUT3 /1  = 327.68 MHz  -> LVDS interface clock (20-bit single-lane
 *                                    DDR needs 10 x fS)
 *   AD9508 OUT2 /10 = 32.768 MHz  -> CNV
 *   AD4080 sinc5+comp at total decimation 8 -> 4.096 MSPS output.
 *
 * CLK and CNV leave the SAME device from matched integer dividers, so their
 * relative phase is deterministic and the +/-535 ps tCCA alignment is structural
 * rather than trimmed.
 *
 * NOTE the ADF4350 is a fractional-N synthesiser with an integrated VCO and is
 * NOT a low-jitter source; expect it to dominate SNR at 1.6 MHz. The eval board
 * provides an external-clock injection path (R65/R68, fitted DNI) for a proper
 * low-phase-noise source when that measurement is made.
 */
&spi1 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	ad9508: clock-controller@0 {
		compatible = "adi,ad9508";
		reg = <0>;
		spi-max-frequency = <10000000>;
		#address-cells = <1>;
		#size-cells = <0>;
		#clock-cells = <1>;

		clocks = <&adf4350>;
		clock-names = "clkin";

		/* OUT0 -> FPGACLK_P/N to FMC CLK1_M2C; not used by this design. */
		channel@0 {
			reg = <0>;
			adi,channel-divider = <1>;
			adi,extended-name = "FPGACLK";
		};

		/* OUT2 -> CNV_P/N. 327.68 / 10 = 32.768 MHz (40 MHz max on this net). */
		channel@2 {
			reg = <2>;
			adi,channel-divider = <10>;
			adi,extended-name = "CNV";
		};

		/* OUT3 -> CLK_P/N. 327.68 MHz (400 MHz max on this net). */
		channel@3 {
			reg = <3>;
			adi,channel-divider = <1>;
			adi,extended-name = "CLK";
		};
	};

	adf4350: pll@1 {
		compatible = "adi,adf4350";
		reg = <1>;
		spi-max-frequency = <10000000>;
		#clock-cells = <0>;

		clocks = <&clk25m>;
		clock-names = "clkin";
		clock-output-names = "adf4350_rfout";

		/* MOD = fPFD / channel-spacing = 25 MHz / 40 kHz = 625. This is what
		 * makes 327.68 MHz land exactly; do not change it casually. */
		adi,channel-spacing = <40000>;
		adi,power-up-frequency = <327680000>;

		adi,phase-detector-polarity-positive-enable;
		adi,charge-pump-current = <2500>;
		adi,muxout-select = <6>;	/* digital lock detect, per schematic note */
		adi,mute-till-lock-enable;
	};
};

&gpio { status = "okay"; };

&usb1 { status = "okay"; };

&dwc3_1 {
	status = "okay";
	dr_mode = "host";
	maximum-speed = "high-speed";
	snps,dis_u2_susphy_quirk;
	snps,dis_u3_susphy_quirk;
};

/* AMS (ZynqMP System Monitor).
 * PS block = SoC die temperature + PS supply rails -> enabled.
 * PL block = left at its zynqmp.dtsi default of "disabled" ON PURPOSE: this
 * design instantiates no PL sysmon, and reading those channels faults ->
 * panic. That fault is why the whole AMS node used to be disabled; scoping
 * the disable to ams_pl recovers SoC temperature without the panic.
 */
&xilinx_ams {
	status = "okay";
};

&ams_ps {
	status = "okay";
};

&i2c1 {
	status = "okay";
	clock-frequency = <400000>;
};

/*
 * RGB status LED (LD5) on the dedicated AXI GPIO. daq-status-led.service:
 * red = booting, blue = iiod starting, green = safe for a PC libiio client.
 */
/ {
	leds {
		compatible = "gpio-leds";
		led-red {
			label = "daq:red";
			gpios = <&rgb_led_gpio 0 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};
		led-green {
			label = "daq:green";
			gpios = <&rgb_led_gpio 1 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
		led-blue {
			label = "daq:blue";
			gpios = <&rgb_led_gpio 2 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};
};
